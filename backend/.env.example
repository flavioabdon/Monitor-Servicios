# Environment variables for SEGIP Monitor Backend

# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://segip:segip_password@localhost:5432/segip_monitor"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production
JWT_EXPIRES_IN=8h

# Institutional authentication
INSTITUTIONAL_AUTH_URL=http://10.0.0.59:53614/
INSTITUTIONAL_AUTH_SUCCESS_MARKER=/Principal/Principal

# Admin credentials (change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin1234!

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="SEGIP Monitor <your_email@gmail.com>"
ALERT_EMAIL_TO=admin@segip.gob.bo

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Ollama Local (AI incident analysis & executive daily summaries)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest
